rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /customers/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }

    match /bookings/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }

    match /invoices/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }

    match /expenses/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }

    match /payments/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }

    match /messages/{documentId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsNew();
      allow update: if ownsExisting() && ownsNew();
    }
  }
}